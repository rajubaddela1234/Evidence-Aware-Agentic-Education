# -----------------------------------------------------------------------------
# Evidence-Aware Agentic Educational Content Generation - v1.4.0
# Gemini scripts, independent Claude evaluation
# -----------------------------------------------------------------------------

# Fixed generation provider for all six benchmark systems.
GENERATION_PROVIDER=gemini
MAX_OUTPUT_TOKENS=your_key_here

# -----------------------------------------------------------------------------
# Gemini generation and frozen-pool planning
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
GEMINI_INPUT_USD_PER_1M=0.75
GEMINI_OUTPUT_USD_PER_1M=3.75

# -----------------------------------------------------------------------------
# Independent Claude evaluator
# cli = local Claude Code login, e.g. Claude Pro
# api = ANTHROPIC_API_KEY through the Anthropic Messages API
# -----------------------------------------------------------------------------
CLAUDE_ACCESS_METHOD=cli
CLAUDE_EVALUATOR_MODEL=claude-sonnet-5-5
CLAUDE_EVALUATOR_MAX_CONTEXT_CHARS=40000
CLAUDE_EVALUATOR_MAX_OUTPUT_TOKENS=your_key_here
CLAUDE_EVALUATOR_TIMEOUT_SECONDS=300
CLAUDE_EVALUATOR_RETRY_ATTEMPTS=3
CLAUDE_EVALUATOR_SHOW_PROGRESS=false

ANTHROPIC_API_KEY=your_key_here
# Claude Sonnet 5.5 standard Anthropic API rates (USD per 1M tokens, November 2026).
# These are list-price estimates, not Claude Code subscription charges.
ANTHROPIC_INPUT_USD_PER_1M=2.00
ANTHROPIC_OUTPUT_USD_PER_1M=10.00

# -----------------------------------------------------------------------------
# LangSmith tracing
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_key_here
LANGSMITH_PROJECT=evidence-aware-edu
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACE_CONTENT=true

# -----------------------------------------------------------------------------
# Retrieval used to build the shared frozen pools and by the Streamlit demo
# -----------------------------------------------------------------------------
TAVILY_API_KEY=your_key_here
YOUTUBE_API_KEY=your_key_here
YOUTUBE_REQUIRE_TRANSCRIPT=true
# Requests for individual transcripts now have bounded network wait times.
YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=10
YOUTUBE_MAX_TRANSCRIPT_CANDIDATES=8

ARXIV_MAX_PAPERS_PER_QUERY=2
ARXIV_FULL_TEXT_CACHE_DIR=data/arxiv_text_cache
ARXIV_PDF_TIMEOUT_SECONDS=20
ARXIV_FALLBACK_TO_ABSTRACT=true

MAX_SOURCES_PER_TOOL=4
MAX_REFERENCE_SOURCES_PER_TOOL=2
MAX_EVIDENCE_PER_QUERY=16
MAX_CONTEXT_CHARS=50000

# -----------------------------------------------------------------------------
# Final held-out benchmark
# -----------------------------------------------------------------------------
USE_FROZEN_REFERENCE_POOL=true
REFERENCE_POOL_DIR=data/reference_pools_final_10q
OUTPUT_DIR=outputs_final_10q

# P1 controls
MAX_REQUIREMENT_RETRIEVAL_ROUNDS=1
MAX_CLAIM_RETRIEVAL_ROUNDS=1
REQUIREMENT_SUPPORT_THRESHOLD=0.70
CLAIM_SUPPORT_THRESHOLD=0.70

# B4 controls
ORIGINAL_MAX_ITERATIONS=3
FEEDBACK_THRESHOLD=7.0

REQUEST_SLEEP_SECONDS=1.0
API_RETRY_ATTEMPTS=6

# -----------------------------------------------------------------------------
# video layer for Streamlit. Video generation is manual only.
# -----------------------------------------------------------------------------
DID_API_KEY=your_key_here
DID_PRESENTER_URL=https://create-images-results.d-id.com/DefaultPresenters/Noelle_f/image.jpeg
DID_VOICE_ID=en-GB-SoniaNeural
